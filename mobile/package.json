{
  "name": "mompopcare-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run clean:test && tsc -p tsconfig.test.json && node --test .tmp-tests/**/*.test.js",
    "clean:test": "node -e \"require('fs').rmSync('.tmp-tests', { recursive: true, force: true })\"",
    "lint": "expo lint",
    "check:expo": "CI=1 expo install --check",
    "validate": "npm run typecheck && npm test && npm run lint && npm run check:expo"
  },
  "dependencies": {
    "expo": "^57.0.4",
    "expo-constants": "~57.0.3",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
